# NetworkManager profile. Copy to wifi.nmconnection, fill in the three
# placeholders, chmod 600. The real file holds the Wi-Fi key: never commit it.
[connection]
id=YOUR_SSID
uuid=REPLACE-WITH-OUTPUT-OF-uuidgen
type=802-11-wireless

[802-11-wireless]
ssid=YOUR_SSID
mode=infrastructure
security=802-11-wireless-security

[802-11-wireless-security]
key-mgmt=wpa-psk
psk=YOUR_WIFI_PASSWORD

[ipv4]
method=auto

[ipv6]
method=auto
ip6-privacy=2
